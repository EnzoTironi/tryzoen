{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "//#build:app": {
      "dependsOn": ["@zoen/companion-ui#build:ui"],
      "env": [
        "BETTER_AUTH_*",
        "BLOB_*",
        "DATABASE_URL",
        "EVE_NEXT_*",
        "*_CONNECTOR_UID",
        "KERNEL_*",
        "LINQ_*",
        "NODE_ENV",
        "OPEN_INSTINCT_LOW_MEM_BUILD",
        "SECRET_ENCRYPTION_KEY",
        "VERCEL_*"
      ],
      "outputs": [".next/**", "!.next/cache/**", ".output/**", "next-env.d.ts"]
    },
    "//#build:vercel": {
      "dependsOn": ["//#db:migrate", "@zoen/companion-ui#build:ui"],
      "env": [
        "BETTER_AUTH_*",
        "BLOB_*",
        "DATABASE_URL",
        "*_CONNECTOR_UID",
        "KERNEL_*",
        "LINQ_*",
        "NODE_ENV",
        "SECRET_ENCRYPTION_KEY",
        "VERCEL_*"
      ],
      "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts"]
    },
    "//#db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL_UNPOOLED"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "//#dev:app": {
      "cache": false,
      "passThroughEnv": [
        "AI_GATEWAY_API_KEY",
        "COMPANION_*",
        "OPENROUTER_API_KEY",
        "BETTER_AUTH_*",
        "BLOB_*",
        "DATABASE_URL",
        "*_CONNECTOR_UID",
        "KERNEL_*",
        "LINQ_*",
        "NODE_ENV",
        "SECRET_ENCRYPTION_KEY",
        "VERCEL_*",
        "WORKFLOW_*"
      ],
      "persistent": true
    },
    "//#deploy:app": {
      "cache": false
    },
    "//#format:check": {
      "outputs": []
    },
    "//#knip": {
      "outputs": []
    },
    "//#lint:app": {
      "outputs": [],
      "dependsOn": ["//#types:generate"]
    },
    "//#start:app": {
      "cache": false,
      "passThroughEnv": [
        "AI_GATEWAY_API_KEY",
        "COMPANION_*",
        "OPENROUTER_API_KEY",
        "BETTER_AUTH_*",
        "BLOB_*",
        "DATABASE_URL",
        "*_CONNECTOR_UID",
        "KERNEL_*",
        "LINQ_*",
        "NODE_ENV",
        "SECRET_ENCRYPTION_KEY",
        "VERCEL_*",
        "WORKFLOW_*"
      ],
      "persistent": true
    },
    "//#test:app": {
      "dependsOn": ["@zoen/companion-ui#build:ui"],
      "outputs": []
    },
    "//#types:generate": {
      "outputs": [".next/types/**", "next-env.d.ts"],
      "dependsOn": ["@zoen/companion-ui#build:ui"]
    },
    "//#types:check:app": {
      "dependsOn": ["//#types:generate"],
      "outputs": ["*.tsbuildinfo"]
    },
    "build:ui": {
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build:ui"],
      "outputs": []
    },
    "build:desktop": {
      "outputs": ["dist/**"]
    }
  }
}

diff --git a/lib/commonjs/RichText/AsyncMessages.js b/lib/commonjs/RichText/AsyncMessages.js
index dadf6de2609384c1e19af5ba4551c1238cae0ce3..a2a001bd6518fd753578877c238a506778386b7f 100644
--- a/lib/commonjs/RichText/AsyncMessages.js
+++ b/lib/commonjs/RichText/AsyncMessages.js
@@ -10,8 +10,10 @@ class AsyncMessages {
     this.subscriptions = {};
   }
   onMessage(id, value) {
-    if (this.subscriptions[id]) {
-      this.subscriptions[id].forEach(callback => {
+    const callbacks = this.subscriptions[id];
+    delete this.subscriptions[id];
+    if (callbacks) {
+      callbacks.forEach(callback => {
         callback(value);
       });
     }
@@ -26,9 +28,22 @@ class AsyncMessages {
     const messageId = Math.random().toString(36).substring(7);
     message.payload = message.payload || {};
     message.payload.messageId = messageId;
-    return new Promise(resolve => {
-      this.addListener(messageId, resolve);
-      postMessage(message);
+    return new Promise((resolve, reject) => {
+      const timeout = setTimeout(() => {
+        delete this.subscriptions[messageId];
+        reject(new Error('The editor did not respond. Try again.'));
+      }, 10000);
+      this.addListener(messageId, (value) => {
+        clearTimeout(timeout);
+        resolve(value);
+      });
+      try {
+        postMessage(message);
+      } catch (error) {
+        clearTimeout(timeout);
+        delete this.subscriptions[messageId];
+        reject(error);
+      }
     });
   }
 }

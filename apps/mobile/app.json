{
  "expo": {
    "name": "Zoen",
    "slug": "zoen",
    "scheme": "zoen",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tryzoen.mobile",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.tryzoen.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "updates": {
      "enabled": false
    },
    "platforms": ["ios", "android", "web"],
    "icon": "../../packages/companion-ui/assets/icon.png",
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Zoen to record voice messages when you tap the microphone.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-video"
    ],
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "pt-BR": "./locales/pt-br.json"
    }
  }
}

{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowJs": true,
    "checkJs": true,
    "paths": { "@web/*": ["../../web/*"] },
    "types": ["node", "react", "react-native"]
  },
  "include": ["**/*.ts", "**/*.tsx", "metro.config.mjs"]
}

{
  "name": "companion-infrastructure",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "plan": "umask 077 && mkdir -p .alchemy && chmod 700 .alchemy && alchemy plan",
    "deploy": "umask 077 && mkdir -p .alchemy && chmod 700 .alchemy && alchemy deploy",
    "destroy": "umask 077 && mkdir -p .alchemy && chmod 700 .alchemy && alchemy destroy",
    "types:check": "../node_modules/.bin/tsc --noEmit",
    "test:providers": "node --test tests/*.test.ts",
    "check:production": "node --env-file=.env.prod operations.ts check",
    "recover:production": "alchemy deploy recovery.run.ts --stage prod --env-file .env.prod --yes"
  },
  "dependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.76",
    "@distilled.cloud/fly-io": "1.0.0-rc.8",
    "@effect/platform-node": "4.0.0-rc.112",
    "alchemy": "2.0.0-beta.76",
    "effect": "4.0.0-rc.115",
    "hono": "4.13.5"
  },
  "devDependencies": {
    "@types/node": "24.10.4"
  }
}

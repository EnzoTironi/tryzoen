    "@types/react-dom": "19.2.5",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-turbo": "2.10.12",
    "knip": "6.32.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tailwindcss": "1.10.0",
    "oxlint-tsgolint": "7.0.2001",
    "portless": "0.15.1",
    "shadcn": "4.19.0",
    "taze": "21.1.0",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.x"
  },
  "exports": {
    "./browser-benchmark-dashboard": "./evals/browser/dashboard/index.ts"
  },
  "name": "local-vault-assistant",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "bench:ab": "node --env-file-if-exists=.env.local --import tsx scripts/run-browser-ab.ts",
    "bench:browser": "eve eval browser",
    "bench:compare": "node --import tsx scripts/compare-browser-benchmarks.ts",
    "bench:dashboard": "portless --name eve-browser-bench next dev evals/browser/dashboard",
    "bench:seed": "tsx scripts/seed-browser-benchmark-vault.ts",
    "build": "turbo run build:app",
    "build:app": "eve build && next build",
    "build:vercel": "next build",
    "check": "turbo run lint:app types:check:app test:app format:check knip",
    "db:check": "drizzle-kit check --dialect postgresql --out db/migrations",
    "db:generate": "drizzle-kit generate --config db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config db/drizzle.config.ts",
    "workflow:migrate": "node --env-file-if-exists=.env.local node_modules/@workflow/world-postgres/bin/setup.js",
    "deps:check": "taze --no-github-actions --no-node-version --fail-on-outdated",
    "deploy": "turbo run deploy:app",
    "deploy:app": "eve deploy",
    "dev": "next dev",
    "dev:app": "next dev",
    "eval": "eve eval",
    "eval:agent": "node --env-file-if-exists=.env.local --import tsx scripts/run-agent-evals.ts",
    "eval:ci": "node --env-file-if-exists=.env.local --import tsx scripts/run-agent-evals.ts --junit .eve/junit.xml",
    "eval:list": "eve eval --list",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip --config knip.config.ts",
    "lint": "turbo run lint:app",
    "lint:app": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "start": "node --env-file-if-exists=.env.local --import tsx scripts/start.ts",
    "start:app": "node --env-file-if-exists=.env.local --import tsx scripts/start.ts",
    "test": "turbo run test:app",
    "test:app": "vitest run",
    "test:runtime": "node --env-file=tests/runtime/.env.example node_modules/vitest/vitest.mjs run --config vitest.runtime.config.ts",
    "types:check": "turbo run types:check:app",
    "types:generate": "next typegen",
    "types:check:app": "tsc --noEmit -p tsconfig.json",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start",
    "test:google-membership": "node --env-file=.env.local --env-file=.env.runtime.local node_modules/tsx/dist/cli.mjs server/google-workspace/membership.integration.ts",
    "test:account-channels": "node --env-file=.env.local --env-file=.env.runtime.local node_modules/tsx/dist/cli.mjs server/accounts/controls.integration.ts",
    "infra:deploy:local": "pnpm --dir infrastructure run deploy --stage local --yes",
    "infra:deploy:dev": "pnpm --dir infrastructure run deploy --stage dev --yes",
    "infra:deploy:staging": "pnpm --dir infrastructure run deploy --stage staging --yes",
    "infra:deploy:prod": "pnpm --dir infrastructure run deploy --stage prod --yes",
    "infra:fly-pg": "bash ./scripts/fly-alchemy-pg.sh",
    "infra:fly-pg:plan:prod": "bash ./scripts/fly-alchemy-pg.sh plan --stage prod",
    "infra:fly-pg:deploy:prod": "bash ./scripts/fly-alchemy-pg.sh deploy --stage prod",
    "ingress:set-webhooks": "bash ./scripts/set-channel-webhooks.sh",
    "test:runtime:setup": "node --import tsx scripts/runtime-tests.ts up",
    "test:runtime:reset": "node --import tsx scripts/runtime-tests.ts reset",
    "test:runtime:down": "node --import tsx scripts/runtime-tests.ts down"
  },
  "version": "0.0.0",
  "type": "module"
}
